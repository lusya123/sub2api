# Copy the http-level block into nginx.conf http {} and the location block into
# the xuedingtoken1.com server {} that proxies Sub2API.
#
# If your CDN sends the real visitor IP in a different header, replace
# $http_x_real_ip with that header.

# --- http {} ---
map $http_x_real_ip $real_client_ip {
    default $http_x_real_ip;
    ""      $remote_addr;
}

limit_req_zone $real_client_ip zone=sub2api_login_limit:10m rate=10r/m;
limit_req_zone $real_client_ip zone=sub2api_global_limit:10m rate=60r/s;
limit_conn_zone $real_client_ip zone=sub2api_conn_limit:10m;

# --- server {} ---
location = /api/v1/auth/login {
    limit_req zone=sub2api_login_limit burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 1k;

    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location / {
    limit_req zone=sub2api_global_limit burst=200 nodelay;
    limit_conn sub2api_conn_limit 50;

    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
